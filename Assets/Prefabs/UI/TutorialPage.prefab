--- !u!114 &3931475847548303493
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8565660042534850924}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<align=\"center\"><size=150%><b><color=#FFD700>Heaven or Hell</color></b></size></align>\r\n\r\n<align=\"center\"><i><color=#AAAAFF>Souls</color>
    vs <color=#FF5555>Reaper</color>. <color=#FFD700>Find Heaven</color> or be caught!</i></align>\r\n\r\n<line-height=120%>\r\n\r\n<size=120%><b><color=#80C1FF>Controls</color></b></size>\r\n<indent=4%>\r\n-
    <b>Move:</b> <color=#FFFFFF>WASD / Arrow Keys</color>  \r\n- <b>Dash:</b> <color=#FFFFFF>SPACE</color> 
    \r\n- <b>Interact:</b> <color=#C1FF80>G</color> <i>(Enter gate or Start altar)</i> 
    \r\n- <b>Ability:</b> <color=#C1FF80>E</color>  \r\n- <b>Reaper Attack:</b> <color=#FFAAAA>Left
    Mouse Button</color>  \r\n</indent>\r\n\r\n<size=120%><b><color=#AAAAFF>Souls</color></b></size>\r\n<indent=4%>\r\n-
    <b>Goal:</b> <color=#FFD700>Find and enter the Heaven Gate</color>  \r\n- <b>Danger:</b>
    Avoid the <color=#FF5555>Reaper</color> and <color=#FF8800>Wall of Fire in Hell
    Gate</color>  \r\n- <b>Weakened?</b> Go to the <color=#66FFCC>Altar</color> with
    a healthy soul for healing (<color=#C1FF80>press G</color> by healthy soul)\r\n</indent>\r\n\r\n\r\n\n\n\n\n\r\n<size=110%><b><color=#80FFC1>Soul
    Types</color></b></size>\r\n<indent=6%>\r\n1. <b><color=#FFCC66>Dog:</color></b>
    Sees all footprints\r\n\r\n\r\n\n\n\n\n\r\r\n2. <b><color=#80C1FF>Detective:</color></b>
    Sees direction of all Gates  \r\n\r\n\r\n\n\n\n\n\r\r\n3. <b><color=#FF80C1>Psychologist:</color></b>
    Can check if a gate is Heaven/Hell only once in game (<color=#C1FF80>press E</color>) 
    \r\n\r\n\r\n\n\n\n\n\r\r\n</indent>\r\n\r\n<size=120%><b><color=#FF5555>Reaper</color></b></size>\r\n<indent=4%>\r\n-
    <b>Goal:</b> <color=#FF5555>Stop all souls</color>  \r\n- <b>Attack:</b> <color=#FFAAAA>Left
    Mouse Button</color> <color=#AAAAAA>(attack souls twice to weaken them)</color>\r\n</indent>\r\n\r\n<size=120%><b><color=#66FFCC>Altar</color></b></size>\r\n<indent=4%>\r\n-
    <b>Healing:</b> When a soul is knocked down, they can move slowly to the <color=#66FFCC>Altar</color> 
    \r\n- <b>Teamwork:</b> Another healthy soul must start the altar\u2019s mini-game
    (<color=#C1FF80>press G</color>)  \r\n- <b>Restore:</b> If completed, the weakened
    soul recovers HP\r\n</indent>\r\n\r\n\r\n\n\n\n\n\r\r\n\r\n<size=120%><b><color=#FFD700>Gates</color></b></size>\r\n<indent=4%>\r\n-
    <b>Heaven Gate:</b> <color=#FFD700>2 per round\u2014enter to win!</color>  \r\n-
    <b>Hell Gate:</b> <color=#FF5555>2 per round. Traps souls in Hell; must escape
    quickly!</color>  \r\n- <b>Normal View:</b> <color=#AAAAAA>Gates look the same</color> 
    \r\n\r\n\r\n\n\n\n\n\r\r\n- <b>Special Vision:</b> <color=#FF80C1>Psychologist</color>
    (after ability) and <color=#FF5555>Reaper</color> see real gate types  \r\n\r\n\r\n\n\n\n\n\r\n</indent>\r\n\r\n---\r\n\r\n<size=100%><i><color=#FFD700>Tip:</color>
    2 Heaven Gate. 2 Hell Gate. <color=#FF5555>If in Hell, escape fast!</color></i></size>\r"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
